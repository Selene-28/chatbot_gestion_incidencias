# Copiar a .env y completar. NUNCA commitear .env (está en .gitignore).

# Base de datos
DB_ROOT_PASSWORD=cambiar
DB_CHATBOT_PASSWORD=cambiar
DB_TICKETS_PASSWORD=cambiar

# Integración tickets (ADR-03: apuntar al sistema real en producción)
TICKETS_API_BASE_URL=http://ticket-service:8001
TICKETS_API_KEY=cambiar

# LLM
ANTHROPIC_API_KEY=cambiar
LLM_MODEL=claude-opus-4-8
LLM_MODEL_ROUTER=claude-haiku-4-5
# Umbral de similitud del RAG (0-1); 0.83 calibrado para e5-small (ver config.py)
RAG_UMBRAL_SIMILITUD=0.83

# Seguridad
JWT_SECRET=cambiar
# Orígenes del sitio WordPress FIIS + demos locales (separados por coma).
# Sin el dominio WP, el navegador bloqueará el chat por CORS.
ALLOWED_ORIGINS=https://fiis.unac.edu.pe,https://www.fiis.unac.edu.pe,https://chatbot.fiis.unac.edu.pe,http://localhost,http://127.0.0.1:5500,http://localhost:5500

# Seeds del ticket-service (usuarios iniciales del panel)
SEED_ADMIN_PASSWORD=cambiar
SEED_TECNICO_PASSWORD=cambiar

# Zona horaria
TZ=America/Lima
