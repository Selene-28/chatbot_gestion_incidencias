# Servidor HTTPS/TLS de PRODUCCIÓN (prd/07 §2, ADR-07).
#
# Para activarlo:
#   1. cp deploy/nginx/conf.d/tls.conf.example deploy/nginx/conf.d/tls.conf
#   2. Ajusta server_name al subdominio real (p. ej. chatbot.fiis.unac.edu.pe).
#   3. Coloca los certificados en ./deploy/certs/ (fullchain.pem, privkey.pem).
#   4. Arranca con el overlay de producción:
#        docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# El cuerpo (rutas, proxy, SSE, rate limit) se comparte con el server :80 vía
# _app.inc, así que no hay que mantener el ruteo en dos lugares.

# Redirige todo el tráfico HTTP a HTTPS (reemplaza el comportamiento :80 en prod).
server {
    listen 80;
    server_name chatbot.fiis.unac.edu.pe;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name chatbot.fiis.unac.edu.pe;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    # HSTS: fuerza HTTPS en el navegador durante 1 año (SEG-03)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/conf.d/_app.inc;
}
